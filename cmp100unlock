#!/usr/bin/env bash
# cmp100unlock - one-command HiveOS CMP100-210 Tensor unlock helper
# SPDX-License-Identifier: GPL-2.0-only
#
# Uses the Tensor unlock research from:
#   https://github.com/Brazzo978/CmpUnlocker-100-210
#
# This wrapper is intentionally narrow. It auto-supports the exact HiveOS
# environment validated during testing: 6.6.0-hiveos, CMP100-210 (10de:1d84),
# exact GV100 firmware hashes below, and NVIDIA 550.142 / 550.163.01.
# The unlock is volatile; a reboot/power cycle returns the GPU to stock.

set -Eeuo pipefail

VERSION="0.1.1-hiveos"
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
APP_DIR="/opt/cmp100unlock"
VENDOR_DIR="$APP_DIR/vendor"
WORK_DIR="$APP_DIR/work"
MARKER="$APP_DIR/.wrapper-version"
KREL="$(uname -r)"

# Exact GV100 firmware hashes validated by the upstream project and reproduced
# on the user's HiveOS CMP100-210 rig.
FECS_SHA="8b636da582662995aa5ed3b8f530299a8aca801934657c85e6a031fb8fd1eab1"
BL_SHA="01326cc997716bebb0eab9fe1f463fffa0ee586079e4ca0e5bb096ab6fcfedab"
UCODE_SHA="b349f0355548716770531eb9082544bb84de059f17bbf3952fb09dd27d8673d4"

# Hive 6.6.0-hiveos package version maps to upstream Linux 6.6.60.
LINUX_VER="6.6.60"
LINUX_TARBALL="linux-${LINUX_VER}.tar.xz"
LINUX_URL="https://cdn.kernel.org/pub/linux/kernel/v6.x/${LINUX_TARBALL}"
LINUX_SHA="52f9e32d5082ab94253447fd66670d0c3bb765cfcb99b0bf61d1b8eae25952ef"

RESTORE_PERSIST=0
START_MINER_AFTER=0

say() { printf '\n==> %s\n' "$*"; }
die() { printf '\nERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
cmp100unlock 0.1.1-hiveos

Usage:
  ./cmp100unlock --unlockall
  ./cmp100unlock --unlockall --start-miner
  ./cmp100unlock --prepare
  ./cmp100unlock --status
  ./cmp100unlock --extract-source DIR
  ./cmp100unlock --version

--unlockall
  Prepares the helper if needed, stops Hive GPU clients, unlocks every visible
  CMP100-210 (10de:1d84), restores nvidia-persistenced, and leaves mining
  stopped unless --start-miner is also supplied.

The first run may install build packages and build Nouveau for Hive's
6.6.0-hiveos kernel. Later runs reuse the installed pieces.

Safety boundary:
  * exact supported firmware hashes are required;
  * only CMP100-210 PCI ID 10de:1d84 is targeted;
  * this build auto-supports kernel 6.6.0-hiveos and NVIDIA 550.142/550.163.01;
  * the change is volatile and disappears on reboot/power cycle.
USAGE
}

need_root() {
  if [[ $EUID -ne 0 ]]; then
    command -v sudo >/dev/null 2>&1 || die "Run as root (sudo is not installed)."
    exec sudo -E "$SELF" "$@"
  fi
}

extract_embedded_vendor() {
  local dest=${1:-$APP_DIR}
  mkdir -p "$dest"
  awk 'found {print} /^__CMP100_EMBEDDED_SOURCE_BELOW__$/ {found=1; next}' "$SELF" \
    | base64 -d \
    | tar -xzf - -C "$dest"
}

install_embedded_vendor() {
  if [[ -f "$MARKER" ]] && [[ "$(cat "$MARKER" 2>/dev/null || true)" == "$VERSION" ]] \
     && [[ -x /usr/local/sbin/cmp100-tensor-unlock ]] \
     && grep -q 'modprobe nouveau modeset=1' /usr/local/sbin/cmp100-tensor-unlock 2>/dev/null; then
    return 0
  fi

  say "Installing embedded CMP100 Tensor helper"
  rm -rf "$VENDOR_DIR"
  mkdir -p "$APP_DIR"
  extract_embedded_vendor "$APP_DIR"

  # HiveOS compatibility patch: its modprobe config forces nouveau modeset=0,
  # and its persistence daemon is not exposed as the expected systemd unit.
  python3 - "$VENDOR_DIR/scripts/cmp100-tensor-unlock" <<'PY'
import sys
p = sys.argv[1]
s = open(p, 'r', encoding='utf-8').read()

if 'modprobe nouveau modeset=1' not in s:
    old = 'modprobe nouveau\n'
    if old not in s:
        raise SystemExit('Cannot locate Nouveau load line in upstream script')
    s = s.replace(old, 'modprobe nouveau modeset=1\n', 1)

if "pkill -TERM -f '(^|/)nvidia-persistenced" not in s:
    old = 'systemctl stop nvidia-persistenced 2>/dev/null || true\n'
    if old not in s:
        raise SystemExit('Cannot locate persistenced stop line in upstream script')
    new = old + r'''pkill -TERM -f '(^|/)nvidia-persistenced([[:space:]]|$)' 2>/dev/null || true
sleep 1
pkill -KILL -f '(^|/)nvidia-persistenced([[:space:]]|$)' 2>/dev/null || true
pkill -TERM -x nvtool 2>/dev/null || true
sleep 1
pkill -KILL -x nvtool 2>/dev/null || true
'''
    s = s.replace(old, new, 1)

open(p, 'w', encoding='utf-8').write(s)
PY

  chmod 0755 "$VENDOR_DIR/install.sh" "$VENDOR_DIR/scripts/cmp100-tensor-unlock"
  (cd "$VENDOR_DIR" && ./install.sh)
  printf '%s\n' "$VERSION" > "$MARKER"
}

check_hash() {
  local path=$1 expected=$2 got
  [[ -f "$path" ]] || die "Missing firmware: $path"
  got=$(sha256sum "$path" | awk '{print $1}')
  [[ "$got" == "$expected" ]] || die "Unsupported firmware hash for $path\nExpected: $expected\nGot:      $got"
}

validate_platform() {
  [[ "$KREL" == "6.6.0-hiveos" ]] || die "This build auto-supports 6.6.0-hiveos only. Running: $KREL"

  command -v lspci >/dev/null 2>&1 || return 1
  lspci -Dnn | grep -qi '10de:1d84' || die "No CMP100-210 (10de:1d84) found."

  check_hash /lib/firmware/nvidia/gv100/gr/fecs_sig.bin "$FECS_SHA"
  check_hash /lib/firmware/nvidia/gv100/acr/bl.bin "$BL_SHA"
  check_hash /lib/firmware/nvidia/gv100/acr/ucode_load.bin "$UCODE_SHA"

  # A previous interrupted/failed handoff can leave the NVIDIA PCI driver
  # unregistered. Recover that state before using nvidia-smi for validation.
  if [[ ! -e /sys/bus/pci/drivers/nvidia/bind || ! -e /sys/bus/pci/drivers/nvidia/unbind ]]; then
    say "NVIDIA PCI driver missing; recovering it before validation"
    modprobe -r nouveau 2>/dev/null || true
    modprobe -r nvidia_uvm 2>/dev/null || true
    modprobe -r nvidia_drm 2>/dev/null || true
    modprobe -r nvidia_modeset 2>/dev/null || true
    modprobe -r nvidia 2>/dev/null || true
    modprobe nvidia || die "Could not recover NVIDIA core module."
    sleep 1
  fi

  local drivers
  drivers=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | sort -u | xargs)
  [[ -n "$drivers" ]] || die "nvidia-smi could not query the GPUs after NVIDIA recovery attempt."
  case "$drivers" in
    "550.142"|"550.163.01") ;;
    *) die "Unsupported NVIDIA driver for this one-command build: $drivers (validated: 550.142, 550.163.01)" ;;
  esac

  [[ -d "/lib/modules/$KREL/build" ]] || die "Missing kernel headers for $KREL"
}

install_packages_if_needed() {
  local pkgs=(build-essential python3 busybox kmod pciutils wget xz-utils bc bison flex libssl-dev libelf-dev dwarves gcc-9 g++-9)
  local missing=() p
  for p in "${pkgs[@]}"; do
    dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing+=("$p")
  done
  if (( ${#missing[@]} )); then
    say "Installing required packages: ${missing[*]}"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y "${missing[@]}"
  fi
}

module_matches_kernel() {
  local ko=${1:-}
  [[ -n "$ko" && -f "$ko" ]] || return 1
  modinfo -F vermagic "$ko" 2>/dev/null | grep -q "^${KREL} "
}

ensure_nouveau() {
  local current manual src tar ko free_kb

  current=$(modinfo -F filename nouveau 2>/dev/null || true)
  if module_matches_kernel "$current"; then
    say "Using existing Nouveau module: $current"
  else
    manual="/home/user/linux-${LINUX_VER}/drivers/gpu/drm/nouveau/nouveau.ko"
    if module_matches_kernel "$manual"; then
      say "Reusing existing Hive-compatible Nouveau build"
      mkdir -p "/lib/modules/$KREL/updates/cmp100"
      cp -f "$manual" "/lib/modules/$KREL/updates/cmp100/nouveau.ko"
      depmod -a
    else
      say "Building Nouveau for $KREL (first run only)"
      mkdir -p "$WORK_DIR"
      tar="$WORK_DIR/$LINUX_TARBALL"
      src="$WORK_DIR/linux-$LINUX_VER"

      free_kb=$(df -Pk "$WORK_DIR" | awk 'NR==2 {print $4}')
      (( free_kb >= 2500000 )) || die "Need about 2.5 GB free under $WORK_DIR to build Nouveau."

      if [[ ! -f "$tar" ]] || [[ "$(sha256sum "$tar" 2>/dev/null | awk '{print $1}')" != "$LINUX_SHA" ]]; then
        rm -f "$tar"
        wget -O "$tar" "$LINUX_URL"
      fi
      [[ "$(sha256sum "$tar" | awk '{print $1}')" == "$LINUX_SHA" ]] || die "Linux source checksum failed."

      if [[ ! -d "$src" ]]; then
        tar -xf "$tar" -C "$WORK_DIR"
      fi

      cd "$src"
      cp "/boot/config-$KREL" .config
      cp .config .config.hive-original
      ./scripts/config --module DRM_NOUVEAU
      ./scripts/config --disable DRM_NOUVEAU_BACKLIGHT
      ./scripts/config --disable DRM_NOUVEAU_SVM
      ./scripts/config --disable NOUVEAU_PLATFORM_DRIVER
      make CC=gcc-9 olddefconfig >/dev/null
      make -j"$(nproc)" CC=gcc-9 KERNELRELEASE="$KREL" modules_prepare
      cp "/lib/modules/$KREL/build/Module.symvers" ./Module.symvers
      make -j"$(nproc)" CC=gcc-9 KERNELRELEASE="$KREL" M=drivers/gpu/drm/nouveau modules

      ko="$src/drivers/gpu/drm/nouveau/nouveau.ko"
      module_matches_kernel "$ko" || die "Built Nouveau vermagic does not match $KREL"
      mkdir -p "/lib/modules/$KREL/updates/cmp100"
      cp -f "$ko" "/lib/modules/$KREL/updates/cmp100/nouveau.ko"
      depmod -a
    fi
  fi

  current=$(modinfo -F filename nouveau 2>/dev/null || true)
  module_matches_kernel "$current" || die "Nouveau is still unavailable for $KREL"

  # ABI/registration smoke test while all cards remain NVIDIA-bound.
  say "Smoke-testing Nouveau module"
  modprobe -r nouveau 2>/dev/null || true
  modprobe nouveau modeset=1
  [[ -e /sys/bus/pci/drivers/nouveau/bind ]] || die "Nouveau loaded but did not register its PCI bind interface."
  rmmod nouveau
}

prepare() {
  need_root "$@"
  install_packages_if_needed
  validate_platform
  ensure_nouveau
  install_embedded_vendor

  local vm
  vm=$(modinfo -F vermagic /usr/lib/cmp100-unlocker/gv100_nouveau_acr_hook.ko 2>/dev/null || true)
  [[ "$vm" == "$KREL "* ]] || die "CMP100 helper module vermagic mismatch: $vm"
  say "Preparation complete"
}

persist_running() {
  pgrep -af '(^|/)nvidia-persistenced([[:space:]]|$)' >/dev/null 2>&1
}

stop_persistence() {
  systemctl stop nvidia-persistenced 2>/dev/null || true
  pkill -TERM -f '(^|/)nvidia-persistenced([[:space:]]|$)' 2>/dev/null || true
  sleep 1
  pkill -KILL -f '(^|/)nvidia-persistenced([[:space:]]|$)' 2>/dev/null || true
}

start_persistence() {
  persist_running && return 0
  if command -v nvidia-persistenced >/dev/null 2>&1; then
    nvidia-persistenced --persistence-mode >/dev/null 2>&1 || true
    sleep 1
  fi
}

restore_runtime() {
  local rc=$?
  trap - EXIT INT TERM
  if (( RESTORE_PERSIST )); then
    start_persistence
  fi
  exit "$rc"
}

stop_gpu_clients() {
  say "Stopping Hive miner and GPU clients"
  if command -v miner >/dev/null 2>&1; then
    miner stop || true
  fi

  pkill -TERM -f '[s]rbminer' 2>/dev/null || true
  pkill -TERM -f '[w]ildrig' 2>/dev/null || true
  pkill -TERM -x Xorg 2>/dev/null || true
  pkill -TERM -x nvtool 2>/dev/null || true
  stop_persistence
  sleep 2
  pkill -KILL -x Xorg 2>/dev/null || true
  pkill -KILL -x nvtool 2>/dev/null || true
  stop_persistence

  # Do not call nvidia-smi here; it opens /dev/nvidia* during the handoff window.
  if fuser /dev/nvidia* >/tmp/cmp100unlock-fuser.$$ 2>&1; then
    printf '\nGPU device handles are still open; refusing to unbind NVIDIA:\n' >&2
    fuser -v /dev/nvidia* 2>&1 || true
    rm -f /tmp/cmp100unlock-fuser.$$
    die "Close the remaining GPU process(es) and run --unlockall again."
  fi
  rm -f /tmp/cmp100unlock-fuser.$$ 2>/dev/null || true
}

detect_all_bdfs() {
  local d out=()
  for d in /sys/bus/pci/devices/0000:*; do
    [[ -r "$d/vendor" && -r "$d/device" ]] || continue
    if [[ "$(<"$d/vendor")" == "0x10de" && "$(<"$d/device")" == "0x1d84" ]]; then
      out+=("${d##*/}")
    fi
  done
  (( ${#out[@]} > 0 )) || die "No CMP100-210 GPUs found."
  printf '%s ' "${out[@]}"
}

ensure_nvidia_core_bound() {
  local targets=$1 bdf devdir current attempt

  # On some HiveOS images, once Xorg/nvtool/nvidia-persistenced are stopped,
  # the NVIDIA core PCI driver can disappear after the Nouveau smoke test.
  # The upstream unlock helper expects /sys/bus/pci/drivers/nvidia/{bind,unbind}
  # to exist, so restore the core driver here before entering its handoff loop.
  if [[ ! -e /sys/bus/pci/drivers/nvidia/unbind || ! -e /sys/bus/pci/drivers/nvidia/bind ]]; then
    say "NVIDIA PCI driver is not registered; reloading NVIDIA core module"
    modprobe -r nouveau 2>/dev/null || true
    modprobe nvidia || die "Could not load NVIDIA core module."

    for attempt in $(seq 1 20); do
      [[ -e /sys/bus/pci/drivers/nvidia/unbind && -e /sys/bus/pci/drivers/nvidia/bind ]] && break
      sleep 0.25
    done
    [[ -e /sys/bus/pci/drivers/nvidia/unbind && -e /sys/bus/pci/drivers/nvidia/bind ]] ||       die "NVIDIA module loaded but PCI bind/unbind interface did not appear."
  fi

  for bdf in $targets; do
    devdir="/sys/bus/pci/devices/$bdf"
    current=$(basename "$(readlink "$devdir/driver" 2>/dev/null)" 2>/dev/null || true)
    case "$current" in
      nvidia)
        ;;
      "")
        printf 'nvidia' > "$devdir/driver_override"
        printf '%s' "$bdf" > /sys/bus/pci/drivers/nvidia/bind ||           die "$bdf could not be rebound to NVIDIA before unlock."
        ;;
      *)
        die "$bdf is unexpectedly bound to '$current' before unlock."
        ;;
    esac
  done

  for bdf in $targets; do
    current=$(basename "$(readlink "/sys/bus/pci/devices/$bdf/driver" 2>/dev/null)" 2>/dev/null || true)
    [[ "$current" == "nvidia" ]] || die "$bdf is not NVIDIA-bound after preflight (driver='$current')."
  done
}

unlock_all() {
  need_root "$@"
  prepare

  local targets
  targets=$(detect_all_bdfs)
  targets=${targets% }
  say "Targets: $targets"

  RESTORE_PERSIST=1
  trap restore_runtime EXIT INT TERM
  stop_gpu_clients
  ensure_nvidia_core_bound "$targets"

  say "Applying volatile Tensor unlock to all CMP100-210 GPUs"
  CMP100_BDFS="$targets" /usr/local/sbin/cmp100-tensor-unlock

  start_persistence
  say "Unlock complete; nvidia-persistenced restored"
  nvidia-smi --query-gpu=index,pci.bus_id,name,driver_version --format=csv,noheader

  if (( START_MINER_AFTER )); then
    if command -v miner >/dev/null 2>&1; then
      say "Starting Hive miner"
      miner start
    else
      printf '\nminer command not found; start your workload manually.\n'
    fi
  else
    printf '\nMining was left stopped intentionally. Start it when ready with: miner start\n'
  fi

  RESTORE_PERSIST=0
  trap - EXIT INT TERM
}

show_status() {
  need_root "$@"
  printf 'cmp100unlock %s\n' "$VERSION"
  printf 'Kernel: %s\n' "$KREL"
  printf 'Nouveau: %s\n' "$(modinfo -F filename nouveau 2>/dev/null || echo missing)"
  printf 'Helper:  %s\n' "$(test -x /usr/local/sbin/cmp100-tensor-unlock && echo installed || echo missing)"
  printf 'Persistence: %s\n' "$(persist_running && echo running || echo stopped)"
  echo
  lspci -Dnn | grep -i '10de:1d84' || true
}

main() {
  [[ $# -gt 0 ]] || { usage; exit 2; }

  # Preserve the original command when elevating so `./cmp100unlock --unlockall`
  # works exactly as typed from the normal Hive user shell.
  case "$1" in
    --version|-h|--help|--extract-source) ;;
    *) need_root "$@" ;;
  esac

  case "$1" in
    --unlockall)
      shift
      if [[ ${1:-} == "--start-miner" ]]; then
        START_MINER_AFTER=1
        shift
      fi
      [[ $# -eq 0 ]] || die "Unexpected argument: $1"
      unlock_all
      ;;
    --prepare)
      shift
      [[ $# -eq 0 ]] || die "Unexpected argument: $1"
      prepare
      ;;
    --status)
      shift
      [[ $# -eq 0 ]] || die "Unexpected argument: $1"
      show_status
      ;;
    --extract-source)
      shift
      [[ $# -eq 1 ]] || die "--extract-source requires a destination directory"
      mkdir -p "$1"
      extract_embedded_vendor "$1"
      printf 'Embedded GPL source extracted to %s/vendor\n' "$1"
      ;;
    --version)
      printf '%s\n' "$VERSION"
      ;;
    -h|--help)
      usage
      ;;
    *)
      usage
      die "Unknown option: $1"
      ;;
  esac
}

main "$@"
exit $?

